# Sao chép file này thành .env rồi chỉnh giá trị:  cp .env.example .env
# KHÔNG commit file .env lên GitHub.

# ---------- Chung ----------
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# JWT HS256: Identity ký, Gateway/Core/Monitoring xác thực bằng CÙNG một secret.
# Tạo secret ngẫu nhiên:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=7

# Khóa dịch vụ bảo vệ các endpoint /internal giữa Core <-> Monitoring (header X-Service-Key)
SERVICE_KEY=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-khac

# ---------- PostgreSQL: 1 container, 3 database, 3 user ----------
# Mật khẩu chỉ dùng chữ và số.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_pass

CORE_DB_NAME=core_db
CORE_DB_USER=core_user
CORE_DB_PASSWORD=core_pass

MONITORING_DB_NAME=monitoring_db
MONITORING_DB_USER=monitoring_user
MONITORING_DB_PASSWORD=monitoring_pass

# ---------- API Gateway ----------
GATEWAY_PORT=8080
# Danh sách origin của web (React) được phép gọi API, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8090
GATEWAY_TIMEOUT_MS=60000
GATEWAY_RATE_LIMIT_PER_MIN=600

# ---------- Identity ----------
# Tài khoản Admin đầu tiên (FR-01), dùng với: npm run db:seed -w services/identity
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_NAME=Administrator

# ---------- Core ----------
DEMO_MODE=true
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Firebase Cloud Messaging.
# Đặt file service account vào thư mục ./secrets/ (đã được .gitignore), KHÔNG commit.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# true: chỉ validate message (dryRun), không gửi thật. Đặt false khi đã có FCM token thật.
FCM_DRY_RUN=true

# ---------- Monitoring ----------
ROOM_ACCESS_TIMEOUT_MS=10000
