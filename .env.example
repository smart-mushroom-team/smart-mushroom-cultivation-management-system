# Sao chép thành .env rồi sửa. KHÔNG commit file .env.

# --- PostgreSQL (một instance, ba database riêng) ---
POSTGRES_PASSWORD=change-me-admin
IDENTITY_DB_PASSWORD=change-me-identity
CORE_DB_PASSWORD=change-me-core
MONITORING_DB_PASSWORD=change-me-monitoring
NIFI_DB_PASSWORD=change-me-nifi

# --- JWT (Identity ký, các service còn lại xác thực cục bộ) ---
JWT_SECRET=change-me-very-long-random-string
JWT_EXPIRE_HOURS=8

# --- Khóa dịch vụ cho endpoint /internal ---
SERVICE_KEY=change-me-service-key

# --- Admin seed (FR-01) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-pw

# --- RabbitMQ ---
RABBITMQ_USER=mushroom
RABBITMQ_PASSWORD=change-me-rabbit

# --- Chế độ demo (FR-26): cho phép chạy job thủ công và đặt ngày giả lập ---
DEMO_MODE=true

# --- Firebase FCM (BR-18): đường dẫn tệp service account, đặt trong ./secrets ---
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
FCM_DRY_RUN=true

# --- NiFi ---
NIFI_USER=admin
NIFI_PASSWORD=change-me-nifi-12chars

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Cổng publish ra mạng LAN (chỉ những cổng này mở ra ngoài) ---
GATEWAY_PORT=8000
