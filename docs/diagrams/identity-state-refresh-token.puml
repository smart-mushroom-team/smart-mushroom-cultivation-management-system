@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam dpi 130
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
title Vòng đời refresh token (refresh_tokens)
state "Còn hiệu lực" as Valid
state "Đã thu hồi\n(revoked_at != NULL)" as Revoked
state "Hết hạn\n(expires_at <= now)" as Expired

[*] --> Valid : cấp khi đăng nhập / làm mới
Valid --> Revoked : dùng để làm mới (xoay vòng, dùng 1 lần)
Valid --> Revoked : đăng xuất
Valid --> Revoked : Admin vô hiệu hóa tài khoản /\nđặt lại mật khẩu
Valid --> Expired : sau 7 ngày
Revoked --> Revoked : bị dùng lại => thu hồi TOÀN BỘ\ntoken của người dùng đó
@enduml
