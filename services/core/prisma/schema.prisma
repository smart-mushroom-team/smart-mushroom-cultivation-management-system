// Core Service — database riêng: core_db
// Quy ước chung và danh sách ràng buộc nâng cao: xem docs/DATABASE.md.
//
// Không có khóa ngoại tới Identity: customerId / userId chỉ là UUID tham chiếu (không truy vấn chéo).
// Các ràng buộc sau nằm trong migration (CUSTOM SQL) vì Prisma không biểu diễn được:
//   BR-01  uq_rental_trays_active_tray   mỗi khay chỉ thuộc tối đa MỘT đơn đang hiệu lực
//   BR-06  uq_cycles_growing_tray        mỗi khay tối đa MỘT đợt nuôi GROWING
//   BR-03  trigger trg_rentals_transitions        PAID->ACTIVE|REJECTED, ACTIVE->EXPIRED->COMPLETED
//   BR-07  trigger trg_cycles_transitions         giai đoạn chỉ tiến một bước; đợt đã kết thúc là bất biến
//   BR-04  CHECK chk_cycles_harvest               chỉ HARVESTED khi stage là FRUITING/READY, có sản lượng
//   ...    nhiều CHECK khác (số tiền, ngày, lý do bắt buộc) — xem migration.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum OccupancyStatus {
  AVAILABLE
  RESERVED
  RENTED
  CLEANING
}

enum RentalStatus {
  PAID
  ACTIVE
  EXPIRED
  COMPLETED
  REJECTED
}

enum TransactionStatus {
  PAID
  REFUNDED
}

// Thứ tự khai báo = thứ tự giai đoạn (so sánh enum trong SQL dựa vào thứ tự này).
enum CycleStage {
  SEEDING
  INCUBATING
  FRUITING
  READY
}

enum CycleStatus {
  GROWING
  HARVESTED
  DISCARDED
}

enum Handover {
  ON_SITE
  DELIVERY
}

enum NotificationType {
  RENTAL_CONFIRMED
  RENTAL_REJECTED
  TRAY_ACTIVATED
  STAGE_CHANGED
  CYCLE_HARVESTED
  CYCLE_DISCARDED
  RENTAL_EXPIRING
  DEVICE_OFFLINE
  THRESHOLD_BREACH
  RENTAL_EXPIRED_WITH_ACTIVE_CYCLE
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model Room {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  trays Tray[]

  @@map("rooms")
}

model Tray {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trayCode        String          @unique @map("tray_code")
  roomId          String          @map("room_id") @db.Uuid
  locationRow     Int             @map("location_row") // hàng
  locationShelf   Int             @map("location_shelf") // kệ
  locationSlot    Int             @map("location_slot") // ô
  occupancyStatus OccupancyStatus @default(AVAILABLE) @map("occupancy_status")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  room        Room         @relation(fields: [roomId], references: [id])
  rentalTrays RentalTray[]

  @@unique([roomId, locationRow, locationShelf, locationSlot])
  @@index([roomId, occupancyStatus])
  @@map("trays")
}

model RentalPackage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  durationDays Int      @map("duration_days")
  pricePerTray Int      @map("price_per_tray") // VND
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rentals Rental[]

  @@map("rental_packages")
}

// Đơn thuê. packageName / durationDays / pricePerTray là bản CHỤP tại thời điểm đặt:
// sửa hoặc tắt gói về sau không ảnh hưởng đơn cũ.
model Rental {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid // sub trong JWT, không có FK
  customerName   String       @map("customer_name") // name trong JWT
  packageId      String       @map("package_id") @db.Uuid
  packageName    String       @map("package_name")
  durationDays   Int          @map("duration_days")
  pricePerTray   Int          @map("price_per_tray")
  trayCount      Int          @map("tray_count")
  totalAmount    Int          @map("total_amount") // VND = pricePerTray x trayCount
  status         RentalStatus @default(PAID)
  startDate      DateTime?    @map("start_date") @db.Date // đặt khi Operator xác nhận (BR-05)
  endDate        DateTime?    @map("end_date") @db.Date
  processedBy    String?      @map("processed_by") @db.Uuid // Operator xác nhận/từ chối
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)
  rejectReason   String?      @map("reject_reason")
  reminderSentAt DateTime?    @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  package      RentalPackage @relation(fields: [packageId], references: [id])
  rentalTrays  RentalTray[]
  transactions Transaction[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([status, endDate]) // Rental Expiry Job
  @@index([packageId])
  @@map("rentals")
}

// Khay thuộc đơn nào. Cặp (rentalId, trayId) là khóa để Đợt nuôi tham chiếu: đợt nuôi
// chỉ có thể tạo cho khay THỰC SỰ thuộc đơn đó.
model RentalTray {
  rentalId  String   @map("rental_id") @db.Uuid
  trayId    String   @map("tray_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active") // false khi đơn REJECTED/COMPLETED
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rental Rental             @relation(fields: [rentalId], references: [id])
  tray   Tray               @relation(fields: [trayId], references: [id])
  cycles CultivationCycle[]

  @@id([rentalId, trayId])
  @@index([trayId])
  @@map("rental_trays")
}

model Transaction {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId  String            @map("rental_id") @db.Uuid
  amount    Int // VND
  status    TransactionStatus
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@map("transactions")
}

model CultivationCycle {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId            String      @map("rental_id") @db.Uuid
  trayId              String      @map("tray_id") @db.Uuid
  stage               CycleStage  @default(SEEDING)
  status              CycleStatus @default(GROWING)
  variety             String? // giống nấm
  startDate           DateTime    @default(now()) @map("start_date") @db.Date
  expectedHarvestDate DateTime?   @map("expected_harvest_date") @db.Date
  harvestedAt         DateTime?   @map("harvested_at") @db.Date
  weightKg            Decimal?    @map("weight_kg") @db.Decimal(8, 2)
  handover            Handover?
  discardReason       String?     @map("discard_reason")
  note                String?
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rentalTray   RentalTray         @relation(fields: [rentalId, trayId], references: [rentalId, trayId])
  progressLogs CycleProgressLog[]

  @@index([rentalId])
  @@index([trayId, status])
  @@map("cultivation_cycles")
}

// Nhật ký tiến độ: dòng đầu (fromStage null -> SEEDING) khi tạo đợt; mỗi lần cập nhật
// tiếp theo ghi thêm một dòng (fromStage = toStage nếu chỉ cập nhật ghi chú).
model CycleProgressLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId   String      @map("cycle_id") @db.Uuid
  fromStage CycleStage? @map("from_stage")
  toStage   CycleStage  @map("to_stage")
  note      String?
  createdBy String      @map("created_by") @db.Uuid // userId Operator, không có FK
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  cycle CultivationCycle @relation(fields: [cycleId], references: [id])

  @@index([cycleId, createdAt])
  @@map("cycle_progress_logs")
}

// Gửi cho MỘT người (recipientUserId) HOẶC cho MỘT VAI TRÒ (recipientRole = 'STAFF'):
// CHECK đảm bảo đúng một trong hai. Trạng thái đã đọc của từng người nằm ở NotificationRead.
// dedupeKey đảm bảo idempotent khi Monitoring/Job gửi lại cùng một cảnh báo (BR-14).
model Notification {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String?          @map("recipient_user_id") @db.Uuid
  recipientRole   String?          @map("recipient_role")
  type            NotificationType
  title           String
  content         String
  data            Json? // vd { rentalId, trayId, roomId } để app điều hướng
  dedupeKey       String?          @unique @map("dedupe_key")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  reads NotificationRead[]

  @@index([recipientUserId, createdAt])
  @@index([recipientRole, createdAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id])

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// FCM token của thiết bị người dùng (Firebase Cloud Messaging).
model DeviceToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("device_tokens")
}

// Cặp khóa-giá trị cho cấu hình lúc chạy, vd key = 'demo_simulated_date' (FR-26).
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
