{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Mushroom Core API",
    "version": "1.0.0",
    "description": "API quản lý hoạt động trồng nấm"
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Core service local development"
    }
  ],
  "components": {
    "schemas": {
      "IdParam": {
        "type": "string",
        "format": "uuid"
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Phòng A"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE",
            "example": "ACTIVE"
          }
        },
        "example": {
          "name": "Phòng A",
          "status": "ACTIVE"
        }
      },
      "UpdateRoomRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Phòng A - Updated"
          }
        },
        "example": {
          "name": "Phòng A - Updated"
        }
      },
      "UpdateRoomStatusRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "example": "INACTIVE"
          }
        },
        "example": {
          "status": "INACTIVE"
        }
      }
    }
  },
  "paths": {
    "/rooms": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "List rooms",
        "responses": {
          "200": {
            "description": "Rooms returned"
          }
        }
      },
      "post": {
        "tags": [
          "Rooms"
        ],
        "summary": "Create a room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              },
              "example": {
                "name": "Phòng A",
                "status": "ACTIVE"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Room created"
          }
        }
      }
    },
    "/rooms/{id}": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Get a room",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdParam"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room returned"
          },
          "404": {
            "description": "Room not found"
          }
        }
      },
      "patch": {
        "tags": [
          "Rooms"
        ],
        "summary": "Update a room",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdParam"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoomRequest"
              },
              "example": {
                "name": "Phòng A - Updated"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Room updated"
          }
        }
      }
    },
    "/rooms/{id}/status": {
      "patch": {
        "tags": [
          "Rooms"
        ],
        "summary": "Change room status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdParam"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoomStatusRequest"
              },
              "example": {
                "status": "INACTIVE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Room status changed"
          }
        }
      }
    }
  },
  "tags": []
}
