// Monitoring Service — database riêng: monitoring_db
// Quy ước chung và danh sách ràng buộc nâng cao: xem docs/DATABASE.md.
//
// roomId chỉ là UUID tham chiếu sang Core (không có FK, không truy vấn chéo).
// Ràng buộc nằm trong migration (CUSTOM SQL) vì Prisma không biểu diễn được:
//   BR-09  uq_devices_active_room_type   mỗi phòng tối đa MỘT thiết bị ACTIVE cho mỗi loại
//   BR-10  CHECK nhiệt độ -40..80, độ ẩm 0..100, ảnh <= 2 MB
//   BR-12  CHECK ngưỡng min < max, N trong 1..20

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  CAMERA
  SENSOR
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum ConnectionState {
  ONLINE
  OFFLINE
}

enum MetricState {
  NORMAL
  ABNORMAL
}

// roomId không đổi sau khi tạo (BR-09); không xóa thiết bị (BR-15).
model Device {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String          @map("room_id") @db.Uuid
  type            DeviceType
  name            String
  apiKeyHash      String          @unique @map("api_key_hash") // SHA-256 của API key; không lưu plaintext
  intervalSec     Int             @map("interval_sec")
  isSimulated     Boolean         @default(false) @map("is_simulated") // UI hiện nhãn "Mô phỏng"
  status          DeviceStatus    @default(ACTIVE)
  connectionState ConnectionState @default(OFFLINE) @map("connection_state")
  lastSeen        DateTime?       @map("last_seen") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cameraLatest CameraLatest?
  readings     SensorReading[]

  @@index([roomId, type])
  @@index([status, connectionState]) // Device Status Scheduler
  @@map("devices")
}

// Mỗi camera đúng một dòng, ghi đè mỗi lần lưu bền (FR-31); không lưu ảnh lịch sử.
model CameraLatest {
  deviceId   String   @id @map("device_id") @db.Uuid
  image      Bytes
  capturedAt DateTime @map("captured_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id])

  @@map("camera_latest")
}

// Giữ 7 ngày rồi xóa (BR-13). Thời điểm lấy theo giờ máy chủ, không tin giờ thiết bị.
model SensorReading {
  id          BigInt   @id @default(autoincrement())
  deviceId    String   @map("device_id") @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  temperature Float
  humidity    Float
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id])

  @@index([roomId, recordedAt])
  @@index([recordedAt]) // Telemetry Retention Job
  @@index([deviceId])
  @@map("sensor_readings")
}

// Ngưỡng theo phòng + trạng thái/bộ đếm chống nhấp nháy cho từng chỉ số (BR-12).
// Đặt ngưỡng một chỉ số thì phải đặt đủ cả min và max (hoặc để trống cả hai = không cảnh báo).
model RoomThreshold {
  roomId           String      @id @map("room_id") @db.Uuid
  tempMin          Float?      @map("temp_min")
  tempMax          Float?      @map("temp_max")
  humMin           Float?      @map("hum_min")
  humMax           Float?      @map("hum_max")
  consecutiveCount Int         @default(3) @map("consecutive_count") // N
  tempState        MetricState @default(NORMAL) @map("temp_state")
  tempOutOfCount   Int         @default(0) @map("temp_out_of_count")
  tempInCount      Int         @default(0) @map("temp_in_count")
  humState         MetricState @default(NORMAL) @map("hum_state")
  humOutOfCount    Int         @default(0) @map("hum_out_of_count")
  humInCount       Int         @default(0) @map("hum_in_count")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("room_thresholds")
}

// Cảnh báo chưa gửi được sang Core (Core lỗi): giữ lại và thử lại ở lần chạy sau (BR-14).
model PendingAlert {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey String    @unique @map("dedupe_key")
  payload   Json
  attempts  Int       @default(0)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sentAt])
  @@map("pending_alerts")
}

// DeviceCommand (điều khiển thiết bị giả lập) ở mức C — thêm khi làm FR-41.
